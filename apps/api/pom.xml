<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.amrap</groupId>
  <artifactId>amrap-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>AMRAP API</name>
  <description>AI Model Results Analysis Platform — Java backend</description>

  <modules>
    <module>api-domain</module>
    <module>api-persistence</module>
    <module>api-security</module>
    <module>api-application</module>
    <module>api-web</module>
    <module>api-llm</module>
    <module>api-bootstrap</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <jjwt.version>0.12.6</jjwt.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Aggregator POM has no main class; only api-bootstrap runs the app. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.amrap</groupId>
        <artifactId>api-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.amrap</groupId>
        <artifactId>api-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.amrap</groupId>
        <artifactId>api-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.amrap</groupId>
        <artifactId>api-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.amrap</groupId>
        <artifactId>api-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.amrap</groupId>
        <artifactId>api-llm</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
