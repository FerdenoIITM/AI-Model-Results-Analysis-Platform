{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amrap.local/schemas/nl-query.json",
  "title": "NaturalLanguageQuery",
  "description": "User natural-language question about stored model results (scaffold).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional filters (modelId, date range, etc.)"
    }
  },
  "required": ["question"]
}
