# Local PostgreSQL (pgAdmin / host install) — used by the API container via host.docker.internal
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=amrap
POSTGRES_USER=amrap
POSTGRES_PASSWORD=changeme

# API (Java Spring Boot)
API_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Web (React) — browser calls the published API port on the host
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

# LLM (later)
OPENAI_API_KEY=
LLM_PROVIDER=openai

# Nginx (optional prod profile)
NGINX_PORT=80
