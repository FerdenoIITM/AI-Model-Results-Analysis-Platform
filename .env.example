# Local PostgreSQL (pgAdmin / host install) — used by the API container via host.docker.internal
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=amrap
POSTGRES_USER=amrap
POSTGRES_PASSWORD=changeme

# API (Java Spring Boot)
API_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Web (React)
# Packaged build (make up): browser calls this URL directly.
# Hot-reload (make dev): leave unused — Vite proxies /api to the api container.
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

# LLM / RAG — local Ollama container (inside compose network)
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b

# RAG storage
# Inside the api container the bind-mount is /var/amrap/results.
# On the host the files live at ./data/results relative to the project root.
RESULTS_STORAGE_DIR=/var/amrap/results

# Shared secret for machine ingest endpoint (POST /api/results). Rotate for prod.
INGEST_API_KEY=change-me-ingest-key

# Worker tuning
RAG_WORKER_DELAY_MS=10000
RAG_WORKER_BATCH_SIZE=5

# Nginx (optional prod profile)
NGINX_PORT=80
