# AMRAP — prod environment. Copy with `make bootstrap ENV=prod` → .env.prod
# Values set to __GENERATE__ are replaced with random secrets by the bootstrap script.
# Only WEB_PORT is published; the browser reaches the API through the web server at /api.

# --- Compose ---
COMPOSE_PROJECT_NAME=amrap-prod
# Empty: use the Postgres installed on the host (database POSTGRES_DB must exist with the schema).
# "db": start a dedicated Postgres + pgvector container instead — then set POSTGRES_HOST=db.
COMPOSE_PROFILES=
TZ=Asia/Kolkata

# --- Published host port ---
WEB_PORT=80

# --- Database ---
# host.docker.internal = the host machine, as seen from a container.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=AMRAP-Prod
POSTGRES_USER=postgres
# Password of POSTGRES_USER on that server (use __GENERATE__ with COMPOSE_PROFILES=db).
POSTGRES_PASSWORD=

# Read-only Postgres login for chat text-to-SQL (see infra/db/migrations/V5*).
# Change via V5b__chat_ro_role.sh after setting a strong CHAT_DB_PASSWORD.
CHAT_DB_USER=amrap_chat_ro
CHAT_DB_PASSWORD=amrap-chat-ro-change-me

# --- API ---
SPRING_PROFILES_ACTIVE=prod
API_INTERNAL_PORT=8080
JWT_SECRET=__GENERATE__
JWT_EXPIRATION_MS=28800000
INGEST_API_KEY=__GENERATE__

# --- Result storage (host path or named volume, mounted at RESULTS_STORAGE_DIR) ---
RESULTS_VOLUME=results_data
RESULTS_STORAGE_DIR=/var/amrap/results

# --- LLM / RAG ---
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_MODELS_VOLUME=amrap_ollama_models
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CLASSIFY_MODEL=qwen2.5:3b
OLLAMA_SQL_MODEL=qwen2.5-coder:7b
OLLAMA_ANSWER_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen2.5:7b
RAG_WORKER_DELAY_MS=10000
RAG_WORKER_BATCH_SIZE=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6

# --- First superadmin (`make superadmin ENV=prod`) ---
SUPERADMIN_EMAIL=superadmin@amrap.local
SUPERADMIN_NAME=Superadmin
SUPERADMIN_PASSWORD=__GENERATE__
