# AMRAP — dev environment (hot reload). Copy with `make bootstrap ENV=dev` → .env.dev
# Values set to __GENERATE__ are replaced with random secrets by the bootstrap script.

# --- Compose ---
COMPOSE_PROJECT_NAME=amrap-dev
# Empty: dev uses the Postgres installed on the host. Set to "db" to run Postgres in a container.
COMPOSE_PROFILES=
TZ=Asia/Kolkata

# --- Published host ports ---
WEB_PORT=5173
API_PORT=8080
OLLAMA_PORT=11434
DB_PORT=5432

# --- Database ---
# host.docker.internal = the host machine, as seen from a container.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=AMRAP-Dev
POSTGRES_USER=postgres
# Password of POSTGRES_USER on that server (use __GENERATE__ with COMPOSE_PROFILES=db).
POSTGRES_PASSWORD=
# Host used by `make dev-local`, where the API runs directly on the host.
DEV_LOCAL_DB_HOST=localhost

# Read-only Postgres login for chat text-to-SQL (role amrap_chat_ro from V5__chat_readonly.sql).
# Default matches the migration; to use a generated secret, set CHAT_DB_PASSWORD then run V5b__chat_ro_role.sh.
CHAT_DB_USER=amrap_chat_ro
CHAT_DB_PASSWORD=amrap-chat-ro-change-me

# --- API ---
SPRING_PROFILES_ACTIVE=dev
API_INTERNAL_PORT=8080
JWT_SECRET=__GENERATE__
JWT_EXPIRATION_MS=86400000
# Shared secret for machine ingest (header X-Ingest-Key on POST /api/results).
INGEST_API_KEY=__GENERATE__

# --- Result storage (host path or named volume, mounted at RESULTS_STORAGE_DIR) ---
RESULTS_VOLUME=./data/results
RESULTS_STORAGE_DIR=/var/amrap/results

# --- LLM / RAG ---
OLLAMA_IMAGE=ollama/ollama:latest
# Volume holding downloaded models; shared by every environment so models download once.
OLLAMA_MODELS_VOLUME=amrap_ollama_models
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Routed chat pipeline (classify → SQL / RAG → answer). OLLAMA_CHAT_MODEL is the answer fallback.
OLLAMA_CLASSIFY_MODEL=qwen2.5:3b
OLLAMA_SQL_MODEL=qwen2.5-coder:7b
OLLAMA_ANSWER_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen2.5:7b
RAG_WORKER_DELAY_MS=10000
RAG_WORKER_BATCH_SIZE=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6

# --- First superadmin (`make superadmin ENV=dev`) ---
SUPERADMIN_EMAIL=superadmin@amrap.local
SUPERADMIN_NAME=Superadmin
SUPERADMIN_PASSWORD=__GENERATE__
