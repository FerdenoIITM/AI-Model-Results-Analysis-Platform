# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates/*.template).
# API_UPSTREAM (host:port of the API inside the compose network) comes from the environment.
# NGINX_LOCAL_RESOLVERS is filled by the image from /etc/resolv.conf (the Docker DNS server).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 25m;

  # Resolve the API per request, so nginx starts before the API and follows it across restarts.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $api_upstream http://${API_UPSTREAM};

  location /api/ {
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
